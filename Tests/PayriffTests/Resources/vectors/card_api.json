  "hosts": {
    "description": "API base URL per PayriffConfig.region and environment (CONTRACT §16.2). The default region is az. warning: the one warning configure logs for that combination (null: none).",
    "defaultRegion": "az",
    "cases": [
      {
        "region": "az",
        "environment": "production",
        "apiBaseUrl": "https://api.payriff.com",
        "warning": null
      },
      {
        "region": "az",
        "environment": "sandbox",
