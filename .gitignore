Example/Config/Secrets*.xcconfig
!Example/Config/Secrets.example.xcconfig

# Secrets, signing material and service configuration: never commit them.
.env
.env.*
!.env.example
*.p12
*.p8
*.cer
*.mobileprovision
*.jks
*.keystore
GoogleService-Info.plist
google-services.json

