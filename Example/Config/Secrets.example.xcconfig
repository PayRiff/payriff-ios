// Template for Secrets.xcconfig (git-ignored). Copy this file:
//
//   cp Example/Config/Secrets.example.xcconfig Example/Config/Secrets.xcconfig
//
// Only Debug builds read it (through Example.Debug.xcconfig). The example never holds a secret
// key: your server creates each order with its own secret key and hands the app orderId and
// clientSecret.

// Your Payriff publishable key (pr_pk_live_…). Create it in the dashboard of the same
// environment; it is not a secret, but keep it out of git anyway.
PAYRIFF_PUBLISHABLE_KEY =

// sandbox or production
PAYRIFF_ENVIRONMENT = sandbox
